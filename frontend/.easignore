# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Env files — keep local secret overrides out, but DO upload .env so the EAS
# build bakes in EXPO_PUBLIC_API_URL (a public, client-side value).
.env*.local

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo

# Native folders — excluded so EAS regenerates them via prebuild (CNG)
# with correct, machine-independent paths and auto-applied config plugins
# (expo-notifications, googleServicesFile, etc.).
android/
ios/
