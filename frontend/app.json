{
  "expo": {
    "name": "IECE's CMS",
    "slug": "iece",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/IECE_Logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ieceaccts.iece",
      "icon": "./assets/apple.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/IECE_Logo.png"
      },
      "package": "com.iece_accts.iece",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/IECE_Logo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "IECE uses the camera to record a short face video for attendance check-in, check-out, and face registration.",
          "microphonePermission": "IECE needs microphone access to record the face-verification video used for attendance.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "IECE accesses your photos so you can attach images to activities and reports."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IECE uses your location to verify that attendance check-in and check-out happen at the correct site."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/IECE_Logo.png",
          "color": "#4F46E5",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/IECE_Logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "IECE saves images and videos you download to your photo library.",
          "granularPermissions": []
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "198a05aa-302b-41b9-994c-757229aa0f88"
      }
    }
  }
}
